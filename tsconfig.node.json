{
  "$schema": "https://json.schemastore.org/tsconfig",
  // CAVEAT: options inlined from @electron-toolkit/tsconfig/tsconfig.node.json.
  // The website (propmanager-website) builds on Netlify with dependencies
  // installed ONLY in its base directory; Astro's bundler (rolldown) still
  // parses the repo-root tsconfigs, so an `extends` into node_modules breaks
  // the deploy. Keep this file self-contained.
  // CAVEAT: src/renderer/locales/*.json is included because the main process statically
  // imports the locale files (exportUtils) — composite projects must list every input file.
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/renderer/locales/*.json"
  ],
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "sourceMap": false,
    "strict": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "composite": true,
    "types": ["electron-vite/node"]
  }
}
