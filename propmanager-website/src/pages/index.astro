---
/**
 * @file Arabic home page — "/" (default locale, no prefix).
 */
import HomePage from '../components/pages/HomePage.astro'
import { t } from '../i18n'
import BaseLayout from '../layouts/BaseLayout.astro'

const locale = 'ar'
const s = t(locale)
---

<BaseLayout locale={locale} title={s.footer.tagline} description={s.meta.siteDescription}>
  <HomePage locale={locale} />
</BaseLayout>
