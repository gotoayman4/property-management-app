---
/**
 * @file Arabic privacy policy — "/privacy".
 */
import PrivacyPage from '../components/pages/PrivacyPage.astro'
import { t } from '../i18n'
import BaseLayout from '../layouts/BaseLayout.astro'

const locale = 'ar'
const s = t(locale)
---

<BaseLayout locale={locale} title={s.legal.privacyTitle} description={s.meta.siteDescription}>
  <PrivacyPage locale={locale} />
</BaseLayout>
